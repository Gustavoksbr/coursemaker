# ============================================
# DATABASE CONFIGURATION
# ============================================
# User and password go embedded in the URL (?user=...&password=...) instead of separate variables.
# Local development
DATABASE_URL=jdbc:postgresql://localhost:5432/coursemaker?user=postgres&password=postgres

# Supabase (production) - use it ONLY as the PostgreSQL host
# DATABASE_URL=jdbc:postgresql://db.xxxxxxx.supabase.co:5432/postgres?user=postgres&password=your-supabase-db-password

# Optional: fixed local dev database, used when running with SPRING_PROFILES_ACTIVE=dev (see
# application-dev.properties and the "Backend Dev (DB local)" terminal). Lets DATABASE_URL point
# at production (e.g. Supabase) while still being able to run locally against a throwaway DB.
# DATABASE_URL_DEV=jdbc:postgresql://localhost:5432/coursemakerbr?user=postgres&password=postgres

# ============================================
# JWT CONFIGURATION (Spring Security)
# ============================================
# Generate with: openssl rand -hex 64
JWT_SECRET=change-me-use-openssl-rand-hex-64-to-generate-a-secure-secret
JWT_EXPIRY_HOURS=24
JWT_ISSUER=coursemaker-api

# ============================================
# RATE LIMIT (all optional - the defaults are generous)
# ============================================
# Login: max failures per (IP + email/nickname) inside the window, then blocked for the block time.
# LOGIN_RATE_LIMIT_MAX_ATTEMPTS=20
# LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
# LOGIN_RATE_LIMIT_BLOCK_SECONDS=30
# Max failures from one IP across all accounts (password spraying).
# LOGIN_RATE_LIMIT_IP_MAX_ATTEMPTS=100
# Sign-up: requests per IP inside the window, then blocked for the block time.
# REGISTER_RATE_LIMIT_MAX_ATTEMPTS=20
# REGISTER_RATE_LIMIT_WINDOW_SECONDS=600
# REGISTER_RATE_LIMIT_BLOCK_SECONDS=60
# Private courses/posts and password-reset tokens: wrong tries in a row, then block (minutes).
# PRIVATE_CONTENT_RATE_LIMIT_MAX_ATTEMPTS=20
# PRIVATE_CONTENT_RATE_LIMIT_BLOCK_MINUTES=1
# Password-reset emails (anti mail-bombing; every request counts, registered email or not).
# PASSWORD_RESET_RATE_LIMIT_MAX_PER_CLIENT=5   # per IP + email
# PASSWORD_RESET_RATE_LIMIT_IP_MAX=20          # per IP, all inboxes
# PASSWORD_RESET_RATE_LIMIT_MAX_PER_EMAIL=15   # per inbox, from anyone (distributed backstop)
# PASSWORD_RESET_RATE_LIMIT_WINDOW_SECONDS=3600
# PASSWORD_RESET_RATE_LIMIT_BLOCK_SECONDS=300
# Minimum wait between two reset emails to the same account.
# PASSWORD_RESET_RESEND_COOLDOWN_SECONDS=60
# "native" behind a reverse proxy like Render (reads X-Forwarded-For); "none" when exposed directly.
# FORWARD_HEADERS_STRATEGY=native

# ============================================
# GOOGLE OAUTH2 (OPTIONAL)
# ============================================
# Leave empty to disable the "Entrar com Google" button.
# NOTE: values must NOT be quoted; this file is parsed as a .properties file.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ============================================
# CLOUDINARY (OPTIONAL - IMAGE UPLOADS)
# ============================================
# Leave CLOUDINARY_CLOUD_NAME empty to disable the "enviar imagem" button; image blocks always
# accept a pasted URL either way. Dashboard: https://cloudinary.com -> Programmable Media.
# NOTE: values must NOT be quoted. The API secret never leaves the backend - it signs each upload,
# the frontend then talks to Cloudinary directly with that signature.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional: which Cloudinary folder uploads land in.
# CLOUDINARY_UPLOAD_FOLDER=coursemaker

# Groq AI Configuration
GROQ_API_KEY=
#GROQ_MODEL=llama-3.1-8b-instant
GROQ_MODEL=llama-3.3-70b-versatile

# ============================================
# RESEND (OPTIONAL - PASSWORD RESET EMAILS)
# ============================================
# Leave RESEND_API_KEY empty to disable "esqueci minha senha" emails (the request endpoint still
# answers normally either way - it just logs instead of sending). Dashboard: https://resend.com
RESEND_API_KEY=
RESEND_EMAIL_FROM=
# How long a reset link stays valid, and the minimum wait between two emails to the same account.
# PASSWORD_RESET_TOKEN_TTL_MINUTES=60

# ============================================
# FIXED ADMIN ACCOUNT (OPTIONAL - LOCAL/TEST ONLY)
# ============================================
# When both are set, the app ensures on every boot that a user with this email exists with
# role=admin and this password (creates it if missing; otherwise promotes it and resets its
# password to match). Leave both empty to disable.
# NEVER set these in a shared or production environment - the password is plain text here and
# gets reset on every boot.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ============================================
# CORS CONFIGURATION
# ============================================
# Frontend origin, no trailing slash. Comma-separated for more than one.
FRONTEND_URL=http://localhost:5173

# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=8080

# ============================================
# PRODUCTION URL (OPTIONAL)
# ============================================
# Public URL of this API once deployed (e.g. on Render). When set, the app self-pings
# GET /api/v1/ping on this URL every 10 minutes to keep the Render instance and the
# Supabase database from going idle. Leave empty to disable (e.g. in local dev).
# API_PRODUCTION_URL=https://coursemaker-api.onrender.com

# ============================================
# CODE RUNNER (OPTIONAL - executable code block)
# ============================================
# piston-gateway (see /piston-gateway). CODE_RUNNER_TOKEN must match the AUTH_TOKEN in
# piston-gateway/.env. Leave the token empty to disable code execution.
# CODE_RUNNER_URL=http://localhost:8081
# CODE_RUNNER_TOKEN=
