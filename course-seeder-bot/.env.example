# ============================================
# GROQ AI CONFIGURATION
# ============================================
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ============================================
# YOUTUBE DATA API (optional - only needed for real-content seeding)
# ============================================
YOUTUBE_API_KEY=

# ============================================
# COURSEMAKER API
# ============================================
# Base URL of the backend (no trailing slash, no /api/v1).
API_BASE_URL=http://localhost:8080

# ============================================
# BOT ACCOUNT
# ============================================
# Each run registers a brand new account: {BOT_EMAIL_PREFIX}{N}{BOT_EMAIL_DOMAIN}.
# N comes from bot-account-counter.txt (gitignored, created automatically next to this file).
BOT_EMAIL_PREFIX=testebot
BOT_EMAIL_DOMAIN=@email.com
BOT_PASSWORD=SenhaForte123!
BOT_NAME=Bot Coursemaker

# ============================================
# CONTENT VOLUME (per run, random within each range)
# ============================================
COURSES_MIN=2
COURSES_MAX=3
MODULES_MIN=2
MODULES_MAX=4
LESSONS_MIN=2
LESSONS_MAX=4
BLOCKS_MIN=2
BLOCKS_MAX=4

# Publish generated courses immediately (status "available", visibility "public").
# Set to false to leave them as drafts only the bot account can see.
PUBLISH_COURSES=true

# ============================================
# REAL-CONTENT SEEDING (build_from_playlist.py only)
# ============================================
# Admin account of the Coursemaker backend - needed to create/reuse a School (admin-only) and
# grant the curator account membership on it. Must match an admin already seeded on that backend
# (see backend's own ADMIN_EMAIL/ADMIN_PASSWORD in backend/.env).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Neutral account that owns courses built from someone else's real content - never the real
# creator's name (see build_from_playlist.py's docstring for why). Reused across runs, unlike the
# random BOT_* account above which is always thrown away.
CURATOR_EMAIL=curadoria@email.com
CURATOR_PASSWORD=SenhaForte123!
CURATOR_NAME=Coursemaker Curadoria
CURATOR_NICKNAME=curadoria
