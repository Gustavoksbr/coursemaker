# ============================================
# GROQ AI CONFIGURATION
# ============================================
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ============================================
# COURSEMAKER API
# ============================================
# Base URL of the backend (no trailing slash, no /api/v1).
API_BASE_URL=http://localhost:8080

# ============================================
# BOT ACCOUNT
# ============================================
# Each run registers a brand new account: {BOT_EMAIL_PREFIX}{N}{BOT_EMAIL_DOMAIN}.
# N comes from bot-account-counter.txt (gitignored, created automatically next to this file).
BOT_EMAIL_PREFIX=testebot
BOT_EMAIL_DOMAIN=@email.com
BOT_PASSWORD=SenhaForte123!
BOT_NAME=Bot Coursemaker

# ============================================
# CONTENT VOLUME (per run, random within each range)
# ============================================
COURSES_MIN=2
COURSES_MAX=3
MODULES_MIN=2
MODULES_MAX=4
LESSONS_MIN=2
LESSONS_MAX=4
BLOCKS_MIN=2
BLOCKS_MAX=4

# Publish generated courses immediately (status "available", visibility "public").
# Set to false to leave them as drafts only the bot account can see.
PUBLISH_COURSES=true
