# Base URL of the Spring Boot API (no trailing slash)
VITE_API_URL=http://localhost:8080

# Google Identity Services client id.
# Leave empty to hide the "Entrar com Google" button; must match GOOGLE_CLIENT_ID on the backend.
VITE_GOOGLE_CLIENT_ID=

# Cloudinary image uploads need no frontend configuration: the backend signs each upload (see
# CLOUDINARY_* in backend/.env) and the frontend asks it for cloud name + signature at upload time.
# The "enviar imagem" button appears automatically once the backend has Cloudinary configured.
