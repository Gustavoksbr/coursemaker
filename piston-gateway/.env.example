# Gere um valor aleatorio, ex: openssl rand -hex 32
# Esse mesmo valor vai no header "Authorization: Bearer <valor>" de quem chamar o gateway.
AUTH_TOKEN=

# So em producao (docker-compose.prod.yml): o dominio que aponta para o IP da VM, ex.: meu-runner.duckdns.org
DOMAIN=

# Opcional (so producao): quais linguagens instalar no Piston. Padrao: node python java gcc typescript php mono go rust ruby kotlin (veja a tabela de linguagens no README).
# Para uma VM de 1 GB: PISTON_PACKAGES=node:20.11.1 python:3.12.0
# PISTON_PACKAGES=

# Opcional: o endereco PUBLICO deste proprio servico (ex.: https://coursemaker-piston.onrender.com, sem /health).
# Quando definido, o gateway chama o proprio /health a cada 10 minutos, para o Render gratuito nao o pôr para
# dormir (e o primeiro codigo executado depois de uma pausa nao esperar a subida). Deixe vazio em dev local.
# AUTO_PING_URL=
